{
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.4.2",
    "node-html-parser": "^7.0.1"
  },
  "scripts": {
    "prepare:dev-sitemap": "astro build && cp dist/sitemap-index.xml public/sitemap-index.xml && cp dist/sitemap-0.xml public/sitemap-0.xml",
    "dev": "bun run prepare:dev-sitemap && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
